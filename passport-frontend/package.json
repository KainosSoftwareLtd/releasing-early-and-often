{
  "name": "release-early-web-app",
  "version": "1.0.0",
  "description": "UK Passport application training module for progressive delivery concepts",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "nyc --reporter=text-summary --reporter=lcov mocha --require test/unit/helper test/unit/spec.*.js && nyc check-coverage --lines 100 --functions 100 --branches 100 --statements 100",
    "test:watch": "mocha --require test/unit/helper test/unit/spec.*.js --watch",
    "test:coverage": "npm test",
    "coverage:check": "nyc check-coverage --lines 100 --functions 100 --branches 100 --statements 100"
  },
  "keywords": [
    "express",
    "passport",
    "training",
    "progressive-delivery"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "govuk-frontend": "^5.10.2",
    "nunjucks": "^3.2.4"
  },
  "overrides": {
    "serialize-javascript": "^7.0.4",
    "diff": "^8.0.3"
  },
  "nyc": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "test/**",
      "**/node_modules/**"
    ],
    "cache": true,
    "check-coverage": false,
    "reporter": [
      "text-summary",
      "lcov"
    ],
    "report-dir": "coverage",
    "extension": [
      ".js"
    ]
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "mocha": "^11.3.0",
    "nodemon": "^3.0.2",
    "sinon": "^18.0.1",
    "sinon-chai": "^3.7.0",
    "supertest": "^7.1.3",
    "nyc": "^15.1.0"
  }
}
